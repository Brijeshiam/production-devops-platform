# ----------------------------
# Terraform core files
# ----------------------------
.terraform/
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# ----------------------------
# Terraform lock file (IMPORTANT - DO NOT IGNORE)
# ----------------------------
.terraform.lock.hcl

# ----------------------------
# Crash logs
# ----------------------------
crash.log
crash.*.log

# ----------------------------
# Terraform variable files (sensitive)
# ----------------------------
*.tfvars
*.tfvars.json

# Example files (optional best practice)
!example.tfvars
!terraform.tfvars.example

# ----------------------------
# Local override files
# ----------------------------
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ----------------------------
# IDE / OS files
# ----------------------------
.vscode/
.idea/
.DS_Store

# ----------------------------
# Dev container (optional)
# ----------------------------
.devcontainer/

# ----------------------------
# Terraform CLI config
# ----------------------------
.terraformrc
terraform.rc